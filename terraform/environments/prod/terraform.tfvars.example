aws_region = "us-east-2"

# Required -- no default on purpose, prod should never silently deploy
# ":latest". A tag build-and-push.yml has already pushed to both the shared
# `backend` and `frontend` ECR repos (<ref>-<sha7>, e.g. v1.4.2-abc1234).
image_tag = "v1.4.2-abc1234"


backend_extra_env = {
  # PORTAL_CLIENT_ID     = ""
  # PORTAL_CLIENT_SECRET = ""
  # SECRET_KEY           = ""
}

frontend_extra_env = {
  # NEXT_PUBLIC_GLOBUS_CLIENT_ID = ""
  # GLOBUS_CLIENT_SECRET         = ""
}
