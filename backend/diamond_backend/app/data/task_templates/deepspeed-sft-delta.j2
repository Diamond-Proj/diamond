diamond_resolve_path() {
  # $1 = raw value, $2 = base dir for relative (non-empty) values.
  # Trims surrounding whitespace, expands $HOME/$USER/~, and prefixes a
  # non-empty relative value with the base dir. Empty stays empty.
  local value="$1" base="$2"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  value="${value//\$\{HOME\}/$HOME}"
  value="${value//\$HOME/$HOME}"
  value="${value//\$\{USER\}/$USER}"
  value="${value//\$USER/$USER}"
  case "$value" in
    "~") value="$HOME" ;;
    "~/"*) value="$HOME/${value#\~/}" ;;
  esac
  if [[ -n "$value" && "$value" != /* ]]; then
    value="$base/$value"
  fi
  printf '%s' "$value"
}


raw_finetuned_model_path="$(cat <<'DIAMOND_FINETUNED_MODEL_PATH'
{{ finetuned_model_path | default('', true) }}
DIAMOND_FINETUNED_MODEL_PATH
)"
resolved_finetuned_model_path="$(diamond_resolve_path "$raw_finetuned_model_path" "{{ location }}")"
if [[ -z "$resolved_finetuned_model_path" ]]; then
  resolved_finetuned_model_path="{{ location }}/models"
fi
resolved_artifact_path="$resolved_finetuned_model_path/{{ finetuned_model_name }}"

# apptainer refuses to bind a source directory that does not exist yet.
mkdir -p "$resolved_finetuned_model_path"

cat << EOF > {{ location }}/{{ task_name }}.submit
#!/bin/bash

#SBATCH --job-name={{ task_name }}
#SBATCH --output={{ stdout_path }}
#SBATCH --error={{ stderr_path }}
#SBATCH --nodes={{ num_of_nodes }}
#SBATCH --time={{ time_duration }}
#SBATCH --partition={{ partition }}
#SBATCH --account={{ account }}
#SBATCH --ntasks-per-node=1
{{ slurm_options }}

apptainer exec --nv \
  --bind {{ model_path }}:/model \
  --bind {{ dataset_path }}:/app/DeepSpeedExamples/applications/DeepSpeed-Chat/data \
  --bind $resolved_finetuned_model_path:/scratch \
  "{{ container_path | default('', true) or '/projects/bcrc/diamond/images/deepspeed_chat.sif' }}" \
  bash <<'DIAMOND_TASK_END'
set -euo pipefail

export CC=/usr/bin/gcc
export CXX=/usr/bin/g++
export PYTHONNOUSERSITE=1

export TRITON_CACHE_DIR=/scratch/triton_cache
mkdir -p "\$TRITON_CACHE_DIR"

export TORCH_EXTENSIONS_DIR=/scratch/torch_extensions
mkdir -p "\$TORCH_EXTENSIONS_DIR"

mkdir -p /scratch/{{ finetuned_model_name }}

export MASTER_ADDR=127.0.0.1
export MASTER_PORT=\$(( 50000 + \${SLURM_JOB_ID: -4} ))
echo "Using MASTER_ADDR=\$MASTER_ADDR MASTER_PORT=\$MASTER_PORT"
echo "output directory: $resolved_artifact_path"
if compgen -G "/model/tokenizer*" > /dev/null; then
  cp -a /model/tokenizer* /scratch/{{ finetuned_model_name }}/
else
  echo "Warning: tokenizer files not found under /model; skipping tokenizer copy" >&2
fi

deepspeed --num_gpus 1 --master_port "\$MASTER_PORT" \
  /app/DeepSpeedExamples/applications/DeepSpeed-Chat/training/step1_supervised_finetuning/main.py \
  --model_name_or_path /model \
  --learning_rate 3e-6 \
  --data_path local/jsonfile \
  --num_train_epochs 4 \
  --gradient_accumulation_steps 8 \
  --lora_dim 32 \
  --zero_stage 1 \
  --per_device_train_batch_size 1 \
  --deepspeed \
  --enable_tensorboard \
  --output_dir /scratch/{{ finetuned_model_name }} \
  --tensorboard_path /scratch/tensorboard
DIAMOND_TASK_END

EOF

sbatch {{ reservation }} {{ location }}/{{ task_name }}.submit
sbatch_rc=$?
if [[ $sbatch_rc -eq 0 ]]; then
  echo "DIAMOND_ARTIFACT_PATH=$resolved_artifact_path"
fi
exit $sbatch_rc
